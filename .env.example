# Copy to .env (gitignored). Values stay EMPTY in this file.
#
# .env may hold ONLY the absolute path to the secrets file, which must live OUTSIDE this
# repository. The bot refuses a path inside the repo, and refuses any other key here.
# API keys go in that secrets file, never in .env.
TRADING_BOT_SECRETS_FILE=
#
# The live gate variable TRADING_BOT_LIVE is NOT read from .env (a value here is refused).
# Set it only in the shell of a live session, together with `bot live --live`.
