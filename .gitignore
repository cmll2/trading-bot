# Python / uv
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Secrets — real secrets live OUTSIDE the repo; never commit any .env
.env
.env.*
!.env.example
*.key
*.pem
# No '*secret*' pattern: it would silently hide source files such as
# bot/secrets.py (audit M0 F-5). Real secrets live outside the repo (bot/config.py).

# Runtime state, data, logs
/data/
/var/
/logs/
*.sqlite
*.sqlite3
*.db
*.parquet
# Recorded test fixtures are tracked (brief §8 consistency test, audit M0 F-5).
!tests/fixtures/**
KILL_SWITCH

# Local tooling
.claude/settings.local.json
